{
  "name": "campus-claw-plus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "npm ci --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "check:spec": "openspec validate --all --strict",
    "check": "npm run check:foundation && npm run check:gate && npm run check:contracts && npm run check:identity-wiring && npm run check:frontend-auth && npm run typecheck && npm run build && npm run check:sample-isolation && npm run check:backend && npm run check:spec",
    "test": "npm run check:backend",
    "audit": "npm audit --audit-level=high && npm audit --prefix frontend --audit-level=high",
    "verify": "node scripts/verify-image-audits.mjs && node scripts/verify-skeleton.mjs && node scripts/verify-identity.mjs",
    "prepare:scan-db": "node scripts/verify-image-audits.mjs --prepare-only",
    "secret-scan": "node scripts/check-secrets.mjs",
    "check:contracts": "node scripts/check-contracts.mjs && node --test scripts/contracts/validate.test.mjs scripts/contracts/identity-phase.test.mjs",
    "check:gate": "node --test scripts/gate.test.mjs",
    "gate": "node scripts/gate.mjs",
    "check:frontend-auth": "node --experimental-strip-types --test frontend/tests/auth.test.mjs frontend/tests/reviewer-auth.test.mjs",
    "check:sample-isolation": "node scripts/check-sample-isolation.mjs",
    "verify:identity": "node scripts/verify-identity.mjs",
    "verify:identity-wiring": "node scripts/verify-identity-wiring.mjs",
    "check:identity-wiring": "node --test scripts/identity-wiring.test.mjs scripts/application-image-report.test.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@fission-ai/openspec": "1.13.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.8.3"
  }
}
