            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./Error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "unauthenticated"
                        }
                      }
                    }
                  ]
