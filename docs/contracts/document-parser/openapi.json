                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./ParseResult.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "enum": [
                            "failed"
                          ]
                        },
                        "failure_reason": {
                          "enum": [
                            "corrupt",
                            "encrypted",
                            "unsupported_content",
                            "resource_limit"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Frozen private response; no-store; never log source content",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "allOf": [
                        {
                          "$ref": "./ParseResult.schema.json"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "enum": [
                                "failed"
                              ]
                            },
                            "failure_reason": {
                              "enum": [
                                "worker_interrupted",
                                "internal_failure"
                              ]
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "busy"
                        }
                      },
                      "required": [
                        "error"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "504": {
            "description": "Frozen private response; no-store; never log source content",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
