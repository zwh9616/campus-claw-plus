    "/v1/parse": {
      "post": {
        "operationId": "privateParseDocument",
        "x-contract-status": "frozen",
        "requestBody": {
          "required": true,
          "content": {
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Frozen private response; no-store; never log source content",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./ParseResult.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "enum": [
                            "ready",
                            "needs_ocr"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
