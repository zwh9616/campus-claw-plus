          },
          "404": {
            "description": "Frozen private response; no-store; never log source content",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./Error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "not_found"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "405": {
            "description": "Frozen private response; no-store; never log source content",
            "headers": {
