  "components": {
    "securitySchemes": {
      "ParserBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "canonical base64url encoding of 32 random bytes"
      }
    },
    "schemas": {
      "ParseResult": {
        "$ref": "./ParseResult.schema.json"
      },
      "Error": {
        "$ref": "./Error.schema.json"
      },
      "Health": {
        "$ref": "./Health.schema.json"
      }
    }
  }
}
