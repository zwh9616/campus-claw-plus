                }
              },
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./Error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "method_not_allowed"
                        }
                      }
                    }
                  ]
                }
              }
