                      "$ref": "./ParseResult.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "enum": [
                            "failed"
                          ]
                        },
                        "failure_reason": {
                          "enum": [
                            "parse_timeout"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
