{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "CampusClawPlus private document parser (frozen, not deployed)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://document-parser:8091"
    }
  ],
  "security": [
    {
      "ParserBearer": []
    }
  ],
  "paths": {
