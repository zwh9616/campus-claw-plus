{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusclaw.invalid/contracts/v1/AuthSession.schema.json",
  "title": "AuthSession",
  "type": "object",
  "properties": {
    "access_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "token_type": {
      "const": "Bearer"
    },
    "expires_in": {
      "const": 900
    },
    "principal": {
      "$ref": "Principal.schema.json"
    }
  },
  "required": [
    "access_token",
    "token_type",
    "expires_in",
    "principal"
  ],
  "additionalProperties": false
}
