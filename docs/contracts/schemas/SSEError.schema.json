{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusclaw.invalid/contracts/v1/SSEError.schema.json",
  "title": "SSEError",
  "type": "object",
  "properties": {
    "turn_id": {
      "$ref": "ID.schema.json"
    },
    "code": {
      "type": "string",
      "enum": [
        "CANCELLED",
        "UPSTREAM_TIMEOUT",
        "STREAM_INTERRUPTED",
        "GENERATION_FAILED"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "turn_id",
    "code",
    "message",
    "retryable"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "const": "CANCELLED"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "message": {
            "const": "已取消"
          },
          "retryable": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "retryable": {
            "const": true
          }
        }
      }
    }
  ]
}
