{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusclaw.invalid/contracts/v1/Turn.schema.json",
  "title": "Turn",
  "type": "object",
  "properties": {
    "turn_id": {
      "$ref": "ID.schema.json"
    },
    "conversation_id": {
      "$ref": "ID.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "generating",
        "completed",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 100000
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "$ref": "Timestamp.schema.json"
    }
  },
  "required": [
    "turn_id",
    "conversation_id",
    "status",
    "text",
    "last_seq",
    "version",
    "error",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "generating",
              "completed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
