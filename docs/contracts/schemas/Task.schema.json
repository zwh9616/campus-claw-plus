{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusclaw.invalid/contracts/v1/Task.schema.json",
  "title": "Task",
  "type": "object",
  "properties": {
    "task_id": {
      "$ref": "ID.schema.json"
    },
    "submission_id": {
      "$ref": "ID.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "execution_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "created_at": {
      "$ref": "Timestamp.schema.json"
    },
    "updated_at": {
      "$ref": "Timestamp.schema.json"
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "task_id",
    "submission_id",
    "status",
    "attempt",
    "execution_epoch",
    "version",
    "cancel_requested",
    "created_at",
    "updated_at",
    "error"
  ],
  "additionalProperties": false
}
