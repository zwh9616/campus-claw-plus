{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusclaw.invalid/contracts/v1/Task.schema.json",
  "title": "Task",
  "type": "object",
  "properties": {
    "task_id": {
      "$ref": "ID.schema.json"
    },
    "submission_id": {
      "$ref": "ID.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "execution_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "created_at": {
      "$ref": "Timestamp.schema.json"
    },
    "updated_at": {
      "$ref": "Timestamp.schema.json"
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "EXECUTION_FAILED"
            },
            "message": {
              "const": "任务执行失败"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "RETRY_EXHAUSTED"
            },
            "message": {
              "const": "重试次数已用尽"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "task_id",
    "submission_id",
    "status",
    "attempt",
    "execution_epoch",
    "version",
    "cancel_requested",
    "created_at",
    "updated_at",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempt": {
            "type": "integer",
            "maximum": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "not": {
              "type": "null"
            }
          },
          "attempt": {
            "minimum": 1,
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "running",
              "succeeded"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempt": {
            "minimum": 1,
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "cancel_requested": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "pending",
              "failed",
              "succeeded"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "cancel_requested": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "const": {
              "code": "RETRY_EXHAUSTED",
              "message": "重试次数已用尽"
            }
          }
        }
      },
      "then": {
        "properties": {
          "attempt": {
            "const": 3
          }
        }
      }
    }
  ]
}
